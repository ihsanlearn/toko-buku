<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.bookstore.controller.AdminController">

    <!-- SIDEBAR -->
    <left>
      <VBox spacing="15" style="-fx-background-color: #1e1e2f;" prefWidth="220">
          <padding>
              <Insets top="25" bottom="20" left="20" right="20"/>
          </padding>

          <Label text="Admin Panel"
                style="-fx-font-size: 22px; -fx-text-fill: white; -fx-font-weight: bold;"/>

          <Separator/>

          <Button fx:id="btnDashboard" text="Dashboard"
                  style="-fx-background-color: transparent; -fx-text-fill: white;"
                  prefWidth="180"/>

          <Button fx:id="btnManageBooks" text="Manage Books"
                  style="-fx-background-color: transparent; -fx-text-fill: white;"
                  prefWidth="180"/>

          <Button fx:id="btnManageUsers" text="Manage Users"
                  style="-fx-background-color: transparent; -fx-text-fill: white;"
                  prefWidth="180"/>

          <Button fx:id="btnReports" text="Reports"
                  style="-fx-background-color: transparent; -fx-text-fill: white;"
                  prefWidth="180"/>

          <!-- Spacer di sini -->
          <Region VBox.vgrow="ALWAYS"/>

          <Button fx:id="btnLogout" text="Logout"
                  style="-fx-background-color: #ff4d4d; -fx-text-fill: white; -fx-font-weight: bold;"
                  prefWidth="180"/>
      </VBox>
    </left>

    <!-- HEADER -->
    <top>
        <HBox style="-fx-background-color: #f4f4f6;" spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" bottom="15" left="20" right="20"/>
            </padding>

            <Label fx:id="pageTitle"
                   text="Dashboard Overview"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: white;">
            <Label text="Welcome to Admin Dashboard"
                   style="-fx-font-size: 18px; -fx-text-fill: #444;"/>
        </StackPane>
    </center>

</BorderPane>
