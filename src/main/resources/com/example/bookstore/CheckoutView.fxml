<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bookstore.controller.CheckoutController"
            stylesheets="@css/checkout.css">

    <center>
        <HBox spacing="25" alignment="TOP_CENTER" styleClass="checkout-root">

            <VBox spacing="18" alignment="TOP_LEFT" prefWidth="450" styleClass="card">
                <Label text="Checkout" styleClass="title" />

                <Label text="Alamat Pengiriman" styleClass="label"/>
                <VBox spacing="10">
                    <ComboBox fx:id="addressCombo" prefWidth="450" promptText="Pilih alamat tersimpan..."/>
                    <CheckBox fx:id="chkSaveAddress" style="-fx-text-fill: #e2e8f0;" text="Simpan alamat ini untuk pengiriman selanjutnya" visible="false" managed="false"/>
                    <GridPane fx:id="newAddressPane" hgap="10" vgap="10" visible="false" managed="false">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                        
                        <Label text="Label (Optional):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtLabel" promptText="e.g. Rumah, Kantor" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Alamat Lengkap:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextArea fx:id="txtAddress" prefRowCount="2" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Kota:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Kode Pos:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtPostalCode" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <Label text="Jasa Pengiriman" styleClass="label"/>
                <ComboBox fx:id="courierCombo" prefWidth="300" styleClass="combo"/>

            </VBox>

            <VBox spacing="15" alignment="TOP_LEFT" prefWidth="350" styleClass="card">
                <Label text="Ringkasan Pembayaran" styleClass="title"/>

                <Label fx:id="summaryLabel" styleClass="summary"/>

                <Separator/>

                <HBox spacing="10">
                    <Button fx:id="cancelBtn" text="Batal" styleClass="btn-cancel" prefWidth="130"/>
                    <Button fx:id="confirmBtn" text="Konfirmasi Pembelian" styleClass="btn-confirm" prefWidth="190"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
