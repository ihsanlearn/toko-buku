<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-padding: 25;" stylesheets="@../css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bookstore.controller.ReportsController">

    <Label style="-fx-font-size: 22px;                 -fx-text-fill: #00e1ff;                 -fx-font-weight: bold;                 -fx-effect: dropshadow(gaussian, rgba(0, 225, 255, 0.6), 15, 0.2, 0, 0);" text="Reports" />

    <HBox spacing="15">
        <Label style=" -fx-text-fill: #00e1ff;                 -fx-font-weight: bold;                 -fx-effect: dropshadow(gaussian, rgba(0, 225, 255, 0.6), 15, 0.2, 0, 0);" text="Report Type:" />
        <ComboBox fx:id="comboReportType" prefWidth="200">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Top Selling Books" />
                    <String fx:value="Low Stock Books" />
                </FXCollections>
            </items>
        </ComboBox>

        <Button fx:id="btnGenerate" text="Generate Report" />
    </HBox>

    <BarChart fx:id="chartReport" animated="false" prefHeight="400" styleClass="custom-chart">
        <xAxis>
            <CategoryAxis label="Category" tickLabelFill="WHITE" />
        </xAxis>
        <yAxis>
            <NumberAxis label="Value" style="-fx-tick-label-fill: white;" tickLabelFill="WHITE" />
        </yAxis>
    </BarChart>

</VBox>
