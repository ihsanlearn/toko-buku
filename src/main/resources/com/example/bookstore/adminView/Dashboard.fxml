<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bookstore.controller.DashboardController"
      alignment="TOP_LEFT"
      style="-fx-padding: 25;">

    <Label text="Dashboard Overview"
           style="-fx-text-fill: #00e1ff;
                  -fx-font-size: 22px;
                  -fx-font-weight: bold;
                  -fx-effect: dropshadow(gaussian, rgba(0, 225, 255, 0.6), 15, 0.2, 0, 0);"/>

    <HBox spacing="20">

        <VBox spacing="10" style="-fx-background-color: #fafafa; -fx-padding: 20; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="200">
            <Label text="Total Books" style="-fx-font-size: 16px;"/>
            <Label fx:id="lblTotalBooks" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: #fafafa; -fx-padding: 20; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="200">
            <Label text="Total Users" style="-fx-font-size: 16px;"/>
            <Label fx:id="lblTotalUsers" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: #fafafa; -fx-padding: 20; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="200">
            <Label text="Books Out of Stock" style="-fx-font-size: 16px;"/>
            <Label fx:id="lblOutOfStock" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <Separator/>

    <Label text="Recent Activity"
           style="-fx-font-size: 18px;
                  -fx-text-fill: #00e1ff;
                  -fx-font-weight: bold;
                  -fx-effect: dropshadow(gaussian, rgba(0, 225, 255, 0.6), 15, 0.2, 0, 0);"/>

    <ListView fx:id="listRecentActivity" prefHeight="200"/>

</VBox>
