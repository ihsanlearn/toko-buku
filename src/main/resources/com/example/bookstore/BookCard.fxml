<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="cardRoot"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.bookstore.controller.BookCardController"
      alignment="CENTER"
      spacing="10"
      styleClass="product-card">

    <StackPane>
        <ImageView fx:id="bookImage" fitWidth="200" fitHeight="280" styleClass="product-image"/>
        <Label fx:id="discountBadge" text="20% OFF" styleClass="discount-badge" visible="false" StackPane.alignment="TOP_RIGHT"/>
    </StackPane>
    <Label fx:id="bookTitle" text="Nama Produk" styleClass="product-name" wrapText="true" textAlignment="CENTER" prefHeight="50" prefWidth="210"/>
    <VBox alignment="CENTER" spacing="2">
        <Text fx:id="originalPrice" text="Rp 100.000" styleClass="original-price" visible="false"/>
        <Label fx:id="bookPrice" text="Harga" styleClass="product-price"/>
        <Label fx:id="soldCountLabel" text="Terjual: 0" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
    </VBox>

</VBox>
