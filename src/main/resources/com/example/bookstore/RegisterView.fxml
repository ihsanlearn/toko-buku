<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="500" prefWidth="800" spacing="0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bookstore.controller.RegisterController">

    <!-- LEFT (FORM) -->
    <VBox alignment="CENTER" spacing="15" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="40" left="40" right="40" top="40"/>
        </padding>

        <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Sign Up"/>

        <TextField fx:id="usernameField" promptText="Username"
                   style="-fx-background-radius: 8; -fx-padding: 10;"/>

        <PasswordField fx:id="passwordField" promptText="Password"
                       style="-fx-background-radius: 8; -fx-padding: 10;"/>

        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"
                       style="-fx-background-radius: 8; -fx-padding: 10;"/>

        <Button fx:id="registerBtn"
                prefHeight="30" prefWidth="150"
                style="-fx-background-color: #0051ff; -fx-text-fill: white; -fx-background-radius: 6;"
                text="Create Account"/>

        <Hyperlink fx:id="backToLogin"
                prefHeight="30" prefWidth="150"
                style="-fx-background-color: transparent; -fx-text-fill: #0051ff; -fx-background-radius: 6;"
                text="Back to Login"/>

    </VBox>

    <!-- RIGHT (BANNER) -->
    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: linear-gradient(to right, #0051ff, #002e99);"
          HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="60" left="40" right="40" top="60"/>
        </padding>

        <Label style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"
               text="Join our bookstore"/>

        <Label style="-fx-text-fill: white; -fx-font-size: 14px;"
               text="Create your account and start managing the bookstore system."
               wrapText="true"/>
    </VBox>

</HBox>
