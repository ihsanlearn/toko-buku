<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bookstore.controller.MainController"
            stylesheets="/com/example/bookstore/css/style.css">

    <!-- HEADER -->
    <top>
        <HBox spacing="20" styleClass="header-bar" fx:id="headerBar" alignment="CENTER_LEFT">
            <Label text="BOOKSTORE" styleClass="header-title"/>
            
            <HBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER">
                 <TextField fx:id="searchField" promptText="Search books..." styleClass="search-field" prefWidth="400"/>
                 <Button text="Search" fx:id="btnSearch" styleClass="search-btn"/>
            </HBox>

            <Button fx:id="btnLogin" text="Login" styleClass="header-button"/>
            <MenuButton text="User" fx:id="accountMenu" styleClass="userMenu">
                <items>
                    <MenuItem fx:id="menuProfile" text="Profile"/>
                    <MenuItem fx:id="menuTopup" text="Top Up"/>
                    <MenuItem fx:id="menuLogout" text="Logout"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="30" style="-fx-padding: 0 0 30 0;">
                    
                    <!-- HERO BANNER -->
                    <StackPane styleClass="hero-banner" prefHeight="300">
                        <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 50;">
                            <Label text="BIG SALE EVENT" styleClass="hero-title"/>
                            <Label text="Get up to 50% off on selected books!" styleClass="hero-subtitle"/>
                            <Button text="Shop Now" styleClass="hero-button"/>
                        </VBox>
                    </StackPane>

                    <VBox spacing="15" style="-fx-padding: 0 40 0 40;">
                        
                        <!-- SPECIAL OFFERS -->
                        <Label text="Special Offers" styleClass="section-title"/>
                        <ScrollPane vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" fitToHeight="true" styleClass="horizontal-scroll">
                            <content>
                                <HBox fx:id="specialOffersContainer" spacing="15" style="-fx-padding: 10;"/>
                            </content>
                        </ScrollPane>

                        <!-- CATEGORIES -->
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="Browse by Category:" style="-fx-font-size: 16px; -fx-text-fill: #555;"/>
                            <ComboBox fx:id="categoryBox" promptText="All Categories" prefWidth="150" styleClass="combo-box"/>
                        </HBox>

                        <!-- ALL BOOKS -->
                        <Label text="Featured Books" styleClass="section-title"/>
                        <FlowPane fx:id="bookContainer" vgap="20" hgap="20" prefWidth="800" styleClass="product-container"/>
                        
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
