<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.bookstore.controller.ManageUsersController"
            style="-fx-padding: 20;">

    <top>
        <Label text="Manage Users"
               style="-fx-font-size: 22px; 
                    -fx-text-fill: #00e1ff;
                    -fx-font-weight: bold;
                    -fx-effect: dropshadow(gaussian, rgba(0, 225, 255, 0.6), 15, 0.2, 0, 0);"/>
    </top>

    <center>
        <TableView fx:id="tableUsers" prefHeight="350">
            <columns>
                <TableColumn fx:id="colUserId" text="ID" prefWidth="70"/>
                <TableColumn fx:id="colUsername" text="Username" prefWidth="150"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #f2f2f2; -fx-border-color: #ccc;" prefWidth="260">

            <Label text="User Detail" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="ID"/>
            <TextField fx:id="detailId" editable="false"/>

            <Label text="Username"/>
            <TextField fx:id="detailUsername"/>

            <Label text="Password"/>
            <PasswordField fx:id="detailPassword"/>

            <Label text="Role"/>
            <ComboBox fx:id="detailRole">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="admin"/>
                        <String fx:value="user"/>
                    </FXCollections>
                </items>
            </ComboBox>

            <HBox spacing="10">
                <Button fx:id="btnUpdateUser" text="Update" style="-fx-background-color: #2196f3; -fx-text-fill: white;"/>
                <Button fx:id="btnDeleteUser" text="Delete" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
            </HBox>

        </VBox>
    </right>

</BorderPane>
