<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.bookstore.controller.AdminController"
            stylesheets="@css/admin.css">

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="15" prefWidth="220" styleClass="sidebar">
            <padding>
                <Insets top="25" bottom="20" left="20" right="20"/>
            </padding>

            <Label text="Admin Panel"/>

            <Separator styleClass="separator"/>

            <Button fx:id="btnDashboard" text="Dashboard"/>
            <Button fx:id="btnManageBooks" text="Manage Books"/>
            <Button fx:id="btnManageUsers" text="Manage Users"/>
            <Button fx:id="btnManageTransactions" text="Manage Transactions"/>
            <Button fx:id="btnReports" text="Reports"/>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnLogout" text="Logout"/>
        </VBox>
    </left>

    <!-- HEADER -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets top="15" bottom="15" left="20" right="20"/>
            </padding>

            <Label fx:id="pageTitle" text="Dashboard Overview"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content">
            <Label text="Welcome to Admin Dashboard"/>
        </StackPane>
    </center>

</BorderPane>
