<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox prefHeight="600" prefWidth="900" spacing="0" styleClass="root" stylesheets="@css/login.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bookstore.controller.RegisterController">

    <!-- LEFT SIDE (FORM) -->
    <VBox alignment="CENTER" prefHeight="601.0" prefWidth="319.0" spacing="20" styleClass="form-container" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="60" left="50" right="50" top="60" />
        </padding>

        <!-- Logo/Icon Circle -->
        <StackPane />

        <!-- Title -->
        <VBox alignment="CENTER" spacing="8">
            <Label styleClass="title" text="Welcome Agent" />
            <Label styleClass="subtitle" text="Please enter your credentials to register" />
        </VBox>

        <Region prefHeight="10" />

        <!-- Username Field -->
        <VBox prefWidth="340" spacing="8">
            <Label styleClass="field-label" text="Username" />
            <TextField fx:id="usernameField" prefHeight="45" promptText="Enter your username" styleClass="input-field" />
        </VBox>

        <!-- Password Field -->
        <VBox prefWidth="340" spacing="8">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="field-label" text="Password" HBox.hgrow="ALWAYS" />
            </HBox>
            <PasswordField fx:id="passwordField" prefHeight="45" promptText="Enter your password" styleClass="input-field" />
        </VBox>
        <VBox prefWidth="340" spacing="8">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="field-label" text="Confirm Password" HBox.hgrow="ALWAYS" />
            </HBox>
            <PasswordField fx:id="confirmPasswordField" prefHeight="45" promptText="Enter your password" styleClass="input-field" />
        </VBox>

        <!-- Login Button -->
        <Button fx:id="registerBtn" prefHeight="38" prefWidth="180" styleClass="login-button" text="Register" />

        <Hyperlink fx:id="backToLogin" styleClass="link-text" text="Back to Login" />
        <Button fx:id="btnBack" text="Back to Home" styleClass="link-button" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"/>

    </VBox>

    <!-- RIGHT SIDE (GRADIENT) -->
    <VBox alignment="CENTER" spacing="25" styleClass="welcome-container" HBox.hgrow="ALWAYS">

        <padding>
            <Insets bottom="80" left="60" right="60" top="80" />
        </padding>

        <!-- Decorative Elements -->
        <StackPane>
            <Circle radius="80" styleClass="deco-circle-outer" />
            <Circle radius="60" styleClass="deco-circle-inner" />
            <Label styleClass="deco-icon" text="📖" />
        </StackPane>

        <VBox alignment="CENTER" maxWidth="380" spacing="15">
            <Label styleClass="welcome-title" text="FBI Books &amp; Co." textAlignment="CENTER" wrapText="true" />

            <Label styleClass="welcome-subtitle" text="&quot;Finding Best Ideas&quot;" textAlignment="CENTER" wrapText="true" />
         <Label alignment="CENTER" layoutX="105.0" layoutY="53.0" prefHeight="44.0" prefWidth="140.0" style="-fx-font-size: 30; -fx-font-weight: bold;" text="Join Us" textAlignment="CENTER" textFill="WHITE" wrapText="true" />
        </VBox>

    </VBox>

</HBox>
