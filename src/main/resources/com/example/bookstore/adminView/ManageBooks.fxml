<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.bookstore.controller.ManageBooksController"
            style="-fx-padding: 20;">

    <top>
        <HBox spacing="20">
            <Label text="Manage Books" style="-fx-font-size: 22px; 
                                              -fx-text-fill: #00e1ff;
                                              -fx-font-weight: bold;
                                              -fx-effect: dropshadow(gaussian, rgba(0, 225, 255, 0.6), 15, 0.2, 0, 0);"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableBooks" prefHeight="400">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colTitle" text="Title" prefWidth="180"/>
                <TableColumn fx:id="colAuthor" text="Author" prefWidth="150"/>
                <TableColumn fx:id="colPrice" text="Price" prefWidth="80"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                <TableColumn fx:id="colImgPath" text="Image Path" prefWidth="80"/>
            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #f8f8f8; -fx-border-color: #ccc;" prefWidth="260">

            <Label text="Book Form" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Title"/>
            <TextField fx:id="inputTitle"/>

            <Label text="Author"/>
            <TextField fx:id="inputAuthor"/>

            <Label text="Price"/>
            <TextField fx:id="inputPrice"/>

            <Label text="Stock"/>
            <TextField fx:id="inputStock"/>

            <Label text="Image Path"/>
            <TextField fx:id="inputImgPath"/>

            <HBox spacing="10">
                <Button fx:id="btnAdd" text="Add"
                        style="-fx-background-color: #4caf50; -fx-text-fill: white;"
                        onAction="#handleAdd"/>

                <Button fx:id="btnUpdate" text="Update"
                        style="-fx-background-color: #2196f3; -fx-text-fill: white;"
                        onAction="#handleUpdate"/>
            </HBox>

            <Button fx:id="btnDelete" text="Delete"
                    style="-fx-background-color: #f44336; -fx-text-fill: white;"
                    onAction="#handleDelete"/>

            <Separator/>

            <Button fx:id="btnClear" text="Clear Form"
                    onAction="#handleClear"/>
        </VBox>
    </right>

</BorderPane>
