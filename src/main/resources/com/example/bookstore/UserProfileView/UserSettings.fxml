<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bookstore.controller.user.SettingsController"
      spacing="20">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Account Settings" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Username:" prefWidth="120"/>
        <TextField fx:id="txtUsername" promptText="Change username"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Email:" prefWidth="120"/>
        <TextField fx:id="txtEmail" promptText="Change email"/>
    </HBox>

    <Separator/>

    <Label text="Change Password" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Old Password:" prefWidth="120"/>
        <PasswordField fx:id="txtOldPassword"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="New Password:" prefWidth="120"/>
        <PasswordField fx:id="txtNewPassword"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Confirm Password:" prefWidth="120"/>
        <PasswordField fx:id="txtConfirmPassword"/>
    </HBox>

    <Button fx:id="btnSave" text="Save Changes" style="-fx-padding: 8 20; -fx-font-size: 14px;"/>

</VBox>
